# ═══════════════════════════════════════════
# CuniGest — .gitignore
# ═══════════════════════════════════════════

# ── Miscellaneous ──
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.buildlog/
.history
.svn/
migrate_working_dir/

# ── Binaries (ne JAMAIS committer) ──
*.exe
*.dll
*.so
*.dylib

# ── AI / Assistants ──
.claude/
.gemini/

# ── IntelliJ / Android Studio ──
*.iml
*.ipr
*.iws
.idea/

# ── VS Code ──
.vscode/

# ── Flutter / Dart / Pub ──
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.packages
.pub-cache/
.pub/
/build/
pubspec.lock

# ── Symbolication ──
app.*.symbols

# ── Obfuscation ──
app.*.map.json

# ── Android ──
/android/app/debug
/android/app/profile
/android/app/release
/android/key.properties
/android/*.jks
/android/*.keystore

# ── Environnement ──
.env
.env.*
sentry.properties

# ── Platform-specific ──
/android/local.properties
/android/.gradle/
/ios/.symlinks/
/ios/Pods/
/ios/Runner.xcworkspace/

# ── Fastlane — clé de service (NE JAMAIS committer) ──
fastlane/service-account.json
**/service-account*.json
fastlane/report.xml
